#!/usr/bin/env bash
# Guard against the two accidents that actually happened on 2026-08-08:
#   1. `git add -A` swept a live experiment's checkpoints into a commit
#   2. private review-prep docs sat untracked in the PUBLIC repo, one add -A
#      away from being pushed to GitHub
# Plus the obvious: never let a credential reach a commit.
# Bypass deliberately with `git commit --no-verify` if you really mean it.
set -u

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
fail=0

# --- 1. credentials -------------------------------------------------------
if git diff --cached -U0 --no-color | grep -qE '^\+.*(github_pat_[A-Za-z0-9_]{20}|ghp_[A-Za-z0-9]{30}|gho_[A-Za-z0-9]{30}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY)'; then
  echo "BLOCKED: a staged change looks like a credential (token / private key)."
  echo "         Find it with: git diff --cached | grep -nE 'github_pat_|ghp_|BEGIN.*PRIVATE KEY'"
  fail=1
fi

# --- 2. private documents must never enter the public repo ----------------
priv=$(echo "$staged" | grep -E '(^|/)(honest_vulnerabilities|tough_questions)\.md$|^qnlp_private_docs/|(^|/)[0-9]{2}_.*_design\.md$' || true)
if [ -n "$priv" ]; then
  echo "BLOCKED: these belong in the LOCAL-ONLY private repo, never in this one:"
  echo "$priv" | sed 's/^/         /'
  fail=1
fi

# --- 3. live-experiment intermediates -------------------------------------
ckpt=$(echo "$staged" | grep -E '_ckpt/|\.pt$|\.log$' || true)
if [ -n "$ckpt" ]; then
  running=$(pgrep -f 'python3? -u exp4' | head -1 || true)
  if [ -n "$running" ]; then
    echo "BLOCKED: an experiment is RUNNING (pid $running) and you are staging its intermediates:"
    echo "$ckpt" | sed 's/^/         /'
    echo "         Commit checkpoints only after the run writes its results JSON."
    fail=1
  fi
fi

# --- 4. results files are append-only (rule 3) ----------------------------
mod=$(git diff --cached --name-only --diff-filter=M | grep -E '^results_.*\.json$' || true)
if [ -n "$mod" ]; then
  echo "BLOCKED: results files are never overwritten (research rule 3). Modified:"
  echo "$mod" | sed 's/^/         /'
  echo "         New script version -> new filename (fresh_results_path handles this)."
  fail=1
fi

[ "$fail" -eq 1 ] && { echo; echo "Nothing was committed. Use --no-verify only if you are certain."; exit 1; }
exit 0
